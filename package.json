{
  "name": "yeti-run",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~57.0.26",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.0",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.23",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.5",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "tsx scripts/sim-check.ts && tsx scripts/controls-check.ts && tsx scripts/feedback-check.ts",
    "preview": "tsx --tsconfig scripts/preview/tsconfig.json scripts/preview/render-preview.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/preview",
    "postinstall": "setup-skia-web public",
    "check:bundle": "expo export --platform ios --platform android --platform web --output-dir dist",
    "check": "npm run typecheck && expo lint && npm test && npm run check:bundle",
    "sounds": "tsx scripts/make-sounds.ts",
    "playtest": "tsx scripts/playtest.ts"
  },
  "private": true
}
